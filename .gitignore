node_modules/
/.pnp
.pnp.js

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/Jest
.nyc_output

# Coverage directory used by tools like istanbul
coverage/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# dotenv environment variables file
.env
.env.*

# Build output
dist/
build/

# IDE/editor folders
.vscode/
.idea/

# macOS
.DS_Store

# Misc
.cache/
.junie/

# Local config (Ollama host/port, lastModel)
config.json

# Local SQLite database
locopilot.db*

# Next.js build output
/.next/
/out/

# Next.js auto-generated types
next-env.d.ts

# TypeScript build info
*.tsbuildinfo

# ── Skills system ───────────────────────────────────────────
# User-created skills should not be committed.  The .gitkeep
# ensures the directory itself is tracked so it exists on clone.
.locopilot/skills/*
!.locopilot/skills/.gitkeep

# Per-project skill enable/disable state (user preference)
.locopilot/skills.json
/debug_400_payload.json

# Copied tiktoken WASM — regenerated by postinstall/prebuild scripts
public/wasm/

