{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format_edited_file.mjs",
            "statusMessage": "Auto-formatting with Prettier...",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node .claude/hooks/present_lint_errors.mjs",
            "statusMessage": "Checking lint on edited file...",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check_package_json_change.mjs",
            "statusMessage": "Checking dependency integrity...",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check_project_lint.mjs",
            "statusMessage": "Running full project lint and type-check...",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
