# ── Server ──────────────────────────────────────────────────────
# Preferred port for the Locopilot web server.
# If unset, defaults to 3000.
# If the port is busy, the next available port is used automatically.
PORT=3000

# Optional server bind host.
# Unset (the default) means the server listens on ALL interfaces
# (0.0.0.0 / [::]) — exactly as before, with no access restriction.
# Set it only to restrict the bind address, e.g. on a shared or managed
# machine:
#   LOCOPILOT_HOST=127.0.0.1   # loopback only (IPv4)
#   LOCOPILOT_HOST=::1         # loopback only (IPv6)
#   LOCOPILOT_HOST=0.0.0.0     # all IPv4 interfaces (the default, explicit)
# Values are trimmed; an empty value means "unset". IPv6 must be unbracketed.
# Read from .env only (not .env.local).
#LOCOPILOT_HOST=

# ── run_command output ───────────────────────────────────────────
# The WHOLE output of a command is kept in a file under the temporary
# directory, and the model is told to read that file instead of seeing a
# truncated excerpt. Secrets in the output are replaced with [REDACTED]
# before they reach the file, the model or the screen.
# Set to 0 to keep nothing on disk: the capture is bounded again. The
# redaction stays on either way — a secret must never reach the model.
#LOCOPILOT_RUN_OUTPUT_SPILL=0

# Where the artifacts live. Unset (the default) means the temporary
# directory of the machine. Point it at a scratch directory to keep the
# artifacts off a shared /tmp; the store creates it with mode 0700, so
# only the owner can read the command output.
#LOCOPILOT_RUN_OUTPUT_DIR=

# How long an artifact is kept before the sweeper evicts it.
# Default: 86400000 (24 hours).
#LOCOPILOT_RUN_OUTPUT_RETENTION_MS=86400000

# How many artifacts ONE session may keep, and how many bytes they may
# take together. The oldest are evicted first.
# Defaults: 100 files and 262144000 bytes (250 MiB).
#LOCOPILOT_RUN_OUTPUT_SESSION_MAX_FILES=100
#LOCOPILOT_RUN_OUTPUT_SESSION_MAX_BYTES=262144000

# How many artifacts the WHOLE store may keep, and how many bytes they
# may take together. Lower these on a machine with a small tmpfs: the
# disk can fill up before the sweeper ever runs.
# Defaults: 1000 files and 1073741824 bytes (1 GiB).
#LOCOPILOT_RUN_OUTPUT_GLOBAL_MAX_FILES=1000
#LOCOPILOT_RUN_OUTPUT_GLOBAL_MAX_BYTES=1073741824
